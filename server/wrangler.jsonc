// Helium Syncer server. To self-host: create your own D1 database and R2
// bucket, put their id/name here, apply schema.sql, then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helium-syncer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "helium.aiwithrishabh.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "helium-syncer", "database_id": "1a5567ff-6569-4439-aa24-a7eeb7e0a529" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "helium-syncer-blobs" }],
  "env": {
    // Local tests: `npx wrangler dev --env dev --local`.
    "dev": {
      "routes": [],
      "d1_databases": [{ "binding": "DB", "database_name": "helium-syncer-dev", "database_id": "local-dev" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "helium-syncer-dev" }]
    }
  }
}
