// Helium Syncer server. To self-host: create your own D1 database and R2
// bucket, put their ids/names here, set MAIL_FROM, then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helium-syncer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "helium.aiwithrishabh.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "helium-syncer", "database_id": "REPLACE_WITH_D1_ID" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "helium-syncer-blobs" }],
  "vars": { "MAIL_MODE": "resend", "MAIL_FROM": "no-reply@aiwithrishabh.com" },
  "env": {
    // Local tests: `npx wrangler dev --env dev` never sends real email.
    "dev": {
      "routes": [],
      "d1_databases": [{ "binding": "DB", "database_name": "helium-syncer-dev", "database_id": "local-dev" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "helium-syncer-dev" }],
      "vars": { "MAIL_MODE": "log", "MAIL_FROM": "no-reply@example.invalid" }
    }
  }
}
