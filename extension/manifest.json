{
  "manifest_version": 3,
  "name": "Helium Syncer",
  "version": "0.3.0",
  "description": "Keeps your bookmarks and open tabs the same on your other computer while you are using Helium.",
  "key": "",
  "permissions": [
    "alarms",
    "bookmarks",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
